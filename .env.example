# ---- LLM provider -------------------------------------------------------
# "groq" (live, needs GROQ_API_KEY), "openai_compatible" (any OpenAI-style
# endpoint), or "mock" (deterministic rule-based stand-in; NOT a real LLM).
MODEL_PROVIDER=mock
# Set to a tool-calling model your Groq key can access (check console.groq.com/docs/models).
MODEL_NAME=
GROQ_API_KEY=
# Only for MODEL_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ---- Storage / retrieval ------------------------------------------------
DATABASE_URL=sqlite:///./data/student_support.db
EMBEDDING_MODEL=tfidf-sparse

# ---- Agent limits ---------------------------------------------------------
MAX_AGENT_STEPS=4
LLM_TIMEOUT_SECONDS=30
